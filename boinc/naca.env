# Compose variables for the NACA BOINC stack (no secrets here).
# Used as: docker compose --project-directory boinc/server -p naca-boinc --env-file boinc/naca.env ...
TAG=
DEFAULTARGS=-defaultargs
# images are built locally from the pinned source (never pulled): local tag
VERSION=local
URL_BASE=http://<TAILNET_IP>
PROJECT=naca
BOINC_USER=boincadm
PROJECT_ROOT=/home/boincadm/project
