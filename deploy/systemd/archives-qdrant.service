[Unit]
Description=Ask the Archives vector store (Qdrant, loopback only)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-docker rm -f archives-qdrant
ExecStart=docker run --rm --name archives-qdrant -p 127.0.0.1:6333:6333 -v %h/data_normalizing/data/qdrant:/qdrant/storage qdrant/qdrant@sha256:d277592721d2e3b73f9b797b53cf05e6a5bb2134f6d13fdbda4ca51782afbcac
ExecStop=docker stop archives-qdrant
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
