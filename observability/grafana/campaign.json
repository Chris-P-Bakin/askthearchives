    {
      "id": 6,
      "title": "Ingest MB/day",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "archives-ch"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "archives-ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "timeseries",
          "rawSql": "SELECT time, metric, sum(d) AS value FROM (SELECT time, metric, greatest(0, v - lagInFrame(v, 1, v) OVER (PARTITION BY metric, series ORDER BY time ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)) * 1 AS d FROM (SELECT toStartOfInterval(ts, INTERVAL 1 DAY) AS time, '' AS metric, toString(labels) AS series, max(value) AS v FROM archives.samples WHERE $__timeFilter(ts) AND name = 'naca_ingest_downloaded_mb_total' GROUP BY time, metric, series)) GROUP BY time, metric ORDER BY time"
        }
      ]
    },
