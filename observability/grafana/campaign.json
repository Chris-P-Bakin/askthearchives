  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "BOINC workunit states",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "archives-ch"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "archives-ch"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfInterval(ts, INTERVAL 5 MINUTE) AS time, name AS metric, max(value) AS value FROM archives.samples WHERE $__timeFilter(ts) AND name IN ('naca_wus_total','naca_wus_valid','naca_wus_invalid','naca_wus_inflight','naca_pages_assimilated') GROUP BY time, metric ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
